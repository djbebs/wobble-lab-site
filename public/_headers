# Cloudflare merges Cache-Control values when more than one rule matches a
# path — a later, more specific rule does NOT override an earlier broader
# one, it gets appended onto it (confirmed live: /assets/dashboard.js came
# back as "immutable, no-cache" when /assets/* and a specific override both
# matched). So the long-cache rule below only lists paths that genuinely are
# static between deploys; dashboard.js/analytics.js are listed separately
# with no-cache and are deliberately NOT covered by any /assets/* glob.

/assets/site.css
  Cache-Control: public, max-age=31536000, immutable

/assets/jelly.js
  Cache-Control: public, max-age=31536000, immutable

/assets/softbody.js
  Cache-Control: public, max-age=31536000, immutable

/assets/ads.js
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Dashboard files are under active development, share the same filenames
# across every deploy, and are not covered by any of the rules above.
/assets/dashboard.js
  Cache-Control: no-cache

/assets/analytics.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
